<?xml version="1.0" encoding="UTF-8"?>
<questions>
    <!-- EASY QUESTIONS -->
    <question difficulty="EASY">
        <topic>Physics</topic>
        <questionString>What does Newton's First Law state?</questionString>
        <option>An object at rest stays at rest unless acted on by a force</option>
        <option>An object in motion will slow down over time</option>
        <option answer="true">An object in motion stays in motion unless acted on by a force</option>
        <option>For every action, there is an equal and opposite reaction</option>
    </question>
    <question difficulty="EASY">
        <topic>Physics</topic>
        <questionString>What is velocity?</questionString>
        <option>Rate of change of speed</option>
        <option answer="true">Speed with direction</option>
        <option>Distance divided by time</option>
        <option>Force divided by mass</option>
    </question>
    <question difficulty="EASY">
        <topic>Physics</topic>
        <questionString>What is the unit of force?</questionString>
        <option>Pascals</option>
        <option>Joules</option>
        <option>Watts</option>
        <option answer="true">Newtons</option>
    </question>
    <question difficulty="EASY">
        <topic>Physics</topic>
        <questionString>What is the speed of light in a vacuum?</questionString>
        <option answer="true">3 × 10<sup>8</sup> m/s</option>
        <option>3 × 10<sup>6</sup> m/s</option>
        <option>300 m/s</option>
        <option>30,000 m/s</option>
    </question>

    <!-- MEDIUM QUESTIONS -->
    <question difficulty="MEDIUM">
        <topic>Physics</topic>
        <questionString>What is the formula for kinetic energy?</questionString>
        <option answer="true">KE = 1/2 mv<sup>2</sup></option>
        <option>KE = mv</option>
        <option>KE = mgh</option>
        <option>KE = mv<sup>3</sup></option>
    </question>
    <question difficulty="MEDIUM">
        <topic>Physics</topic>
        <questionString>What is the acceleration due to gravity on Earth?</questionString>
        <option>8.9 m/s<sup>2</sup></option>
        <option answer="true">9.8 m/s<sup>2</sup></option>
        <option>10.5 m/s<sup>2</sup></option>
        <option>7.8 m/s<sup>2</sup></option>
    </question>
    <question difficulty="MEDIUM">
        <topic>Physics</topic>
        <questionString>What is the relationship between force, mass, and acceleration?</questionString>
        <option>F = ma<sup>2</sup></option>
        <option answer="true">F = ma</option>
        <option>F = m + a</option>
        <option>F = a/m</option>
    </question>

    <!-- HARD QUESTIONS -->
    <question difficulty="HARD">
        <topic>Physics</topic>
        <questionString>What is the second law of thermodynamics?</questionString>
        <option>The entropy of a system always increases</option>
        <option>The total energy of a system remains constant</option>
        <option answer="true">Entropy of an isolated system never decreases</option>
        <option>Heat cannot flow from cold to hot without work</option>
    </question>
    <question difficulty="HARD">
        <topic>Physics</topic>
        <questionString>What is the formula for calculating work done?</questionString>
        <option answer="true">W = F × d × cosθ</option>
        <option>W = F × d</option>
        <option>W = F × d × sinθ</option>
        <option>W = F × d × tanθ</option>
    </question>
    <question difficulty="HARD">
        <topic>Physics</topic>
        <questionString>What is the principle of conservation of momentum?</questionString>
        <option>Momentum is always created in a system</option>
        <option answer="true">The total momentum of a system remains constant</option>
        <option>Momentum is the rate of change of force</option>
        <option>Momentum is inversely proportional to velocity</option>
    </question>
</questions>
