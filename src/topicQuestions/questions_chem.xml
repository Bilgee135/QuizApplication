    </question>
    <question difficulty="MEDIUM">
        <topic>Chemistry</topic>
        <questionString>Which element is represented by the symbol "K" on the periodic table?</questionString>
        <option>Kalium</option>
        <option>Calcium</option>
        <option answer="true">Potassium</option>
        <option>Sodium</option>
    </question>

