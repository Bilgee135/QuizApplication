<?xml version="1.0" encoding="UTF-8"?>
<questions>
    <!-- EASY QUESTIONS -->
    <question difficulty="EASY">
        <topic>Chemistry</topic>
        <questionString>What is an isotope?</questionString>
        <option>An atom with a negative charge</option>
        <option>A molecule formed by two elements</option>
        <option answer="true">Atoms of the same element with different numbers of neutrons</option>
        <option>Atoms that combine to form compounds</option>
    </question>
    <question difficulty="EASY">
        <topic>Chemistry</topic>
        <questionString>What is the chemical symbol for water?</questionString>
        <option>H</option>
        <option>O2</option>
        <option>C</option>
        <option answer="true">H2O</option>
    </question>
    <question difficulty="EASY">
        <topic>Chemistry</topic>
        <questionString>Which of the following is a noble gas?</questionString>
        <option>Oxygen</option>
        <option>Hydrogen</option>
        <option answer="true">Helium</option>
        <option>Carbon</option>
    </question>
    <question difficulty="EASY">
        <topic>Chemistry</topic>
        <questionString>Which of the following is the smallest particle of matter?</questionString>
        <option>Electron</option>
        <option>Molecule</option>
        <option answer="true">Atom</option>
        <option>Neutron</option>
    </question>

    <!-- MEDIUM QUESTIONS -->
    <question difficulty="MEDIUM">
        <topic>Chemistry</topic>
        <questionString>What is the pH value of pure water at room temperature?</questionString>
        <option>6</option>
        <option>5</option>
        <option answer="true">7</option>
        <option>8</option>
    </question>
    <question difficulty="MEDIUM">
        <topic>Chemistry</topic>
        <questionString>What is Avogadro's number?</questionString>
        <option>6.02 x 10<sup>22</sup></option>
        <option>1.02 x 10<sup>23</sup></option>
        <option>6.02 x 10<sup>24</sup></option>
