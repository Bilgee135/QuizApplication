<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="QuizAppGUI.Index">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="30" left="60" bottom="30" right="60"/>
    <constraints>
      <xy x="20" y="20" width="800" height="500"/>
    </constraints>
    <properties>
      <background color="-5587033"/>
      <enabled value="true"/>
      <font name="Arial" size="14" style="1"/>
      <minimumSize width="800" height="500"/>
      <preferredSize width="800" height="500"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="2db8c" class="javax.swing.JLabel" binding="quizTitle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <focusable value="false"/>
          <font size="28" style="1"/>
          <foreground color="-6180"/>
          <opaque value="false"/>
          <text value="Welcome to Quiz Application!"/>
        </properties>
      </component>
      <component id="daecd" class="javax.swing.JButton" binding="loginButton" default-binding="true">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="20" height="20"/>
          </grid>
        </constraints>
        <properties>
          <background color="-6180"/>
          <borderPainted value="true"/>
          <defaultCapable value="true"/>
          <enabled value="true"/>
          <focusPainted value="false"/>
          <focusable value="false"/>
          <font size="18"/>
          <foreground color="-5587033"/>
          <opaque value="true"/>
          <text value="Login"/>
        </properties>
      </component>
      <component id="feacd" class="javax.swing.JButton" binding="signupButton" default-binding="true">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-6180"/>
          <borderPainted value="true"/>
          <contentAreaFilled value="true"/>
          <focusable value="false"/>
          <font size="18"/>
          <foreground color="-5587033"/>
          <opaque value="true"/>
          <text value="Signup"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
