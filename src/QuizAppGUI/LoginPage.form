<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="QuizAppGUI.LoginPage">
  <grid id="27dc6" binding="loginPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="500"/>
    </constraints>
    <properties>
      <background color="-5587033"/>
      <font name="Arial" size="14" style="1"/>
      <minimumSize width="800" height="500"/>
      <preferredSize width="800" height="500"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="7802f" binding="backButtonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="10" bottom="5" right="5"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-5587033"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="bf018" class="javax.swing.JButton" binding="backButton" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font size="14"/>
              <foreground color="-5587033"/>
              <text value="Back "/>
            </properties>
          </component>
          <hspacer id="5a83d">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <grid id="86f6e" binding="loginFieldPanel" layout-manager="GridLayoutManager" row-count="8" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="0">
        <margin top="0" left="180" bottom="150" right="180"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-5587033"/>
          <foreground color="-5587033"/>
          <visible value="true"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="45cf6" class="javax.swing.JTextField" binding="usernameField">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="1" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="30"/>
              </grid>
            </constraints>
            <properties>
              <background color="-6180"/>
              <font name="Arial" size="14"/>
              <margin top="2" left="6" bottom="2" right="6"/>
              <minimumSize width="200" height="30"/>
              <preferredSize width="200" height="30"/>
            </properties>
          </component>
          <component id="654b0" class="javax.swing.JButton" binding="loginButton">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font name="Arial" size="14"/>
              <preferredSize width="200" height="30"/>
              <text value="Login"/>
            </properties>
          </component>
          <component id="aa314" class="javax.swing.JLabel" binding="loginLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="24" style="1"/>
              <foreground color="-6180"/>
              <text value="Login to your existing account"/>
            </properties>
          </component>
          <component id="b7f49" class="javax.swing.JLabel" binding="usernameLabel">
            <constraints>
              <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-6180"/>
              <labelFor value="45cf6"/>
              <text value="Username"/>
            </properties>
          </component>
          <component id="e03e0" class="javax.swing.JPasswordField" binding="passwordField">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="1" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="30"/>
              </grid>
            </constraints>
            <properties>
              <background color="-6180"/>
              <dragEnabled value="false"/>
              <font name="Arial" size="14"/>
              <foreground color="-14605013"/>
              <margin top="2" left="6" bottom="2" right="6"/>
              <preferredSize width="200" height="30"/>
            </properties>
          </component>
          <component id="1af9e" class="javax.swing.JLabel" binding="passwordLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-6180"/>
              <labelFor value="e03e0"/>
              <text value="Password"/>
            </properties>
          </component>
          <component id="cadc8" class="javax.swing.JLabel" binding="errorMessage">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="16" style="0"/>
              <foreground color="-4259840"/>
              <text value="Incorrect username or password!"/>
              <visible value="false"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
