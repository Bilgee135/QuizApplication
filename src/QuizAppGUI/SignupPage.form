<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="QuizAppGUI.SignupPage">
  <grid id="27dc6" binding="signupPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="800" height="524"/>
    </constraints>
    <properties>
      <background color="-5587033"/>
      <minimumSize width="800" height="500"/>
      <preferredSize width="800" height="500"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="4480d" binding="backButtonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="5" left="10" bottom="5" right="5"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-5587033"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="ed39" class="javax.swing.JButton" binding="backButton" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font size="14"/>
              <foreground color="-5587033"/>
              <text value="Back "/>
            </properties>
          </component>
          <hspacer id="d6c39">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
        </children>
      </grid>
      <grid id="860b" binding="signupFieldPanel" layout-manager="GridLayoutManager" row-count="6" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="180" bottom="150" right="180"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-5587033"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="2daf6" class="javax.swing.JLabel" binding="loginLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="24" style="1"/>
              <foreground color="-6180"/>
              <text value="Create a new account"/>
            </properties>
          </component>
          <component id="73dd8" class="javax.swing.JTextField" binding="textField1" default-binding="true">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="9" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="30"/>
              </grid>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font name="Arial" size="14" style="1"/>
            </properties>
          </component>
          <component id="bd11d" class="javax.swing.JTextField" binding="passwordTextField" default-binding="true">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="30"/>
              </grid>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-6180"/>
              <text value=""/>
            </properties>
          </component>
          <component id="b0f02" class="javax.swing.JButton" binding="signupButton" default-binding="true">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-6180"/>
              <focusable value="false"/>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-14605013"/>
              <text value="Signup"/>
            </properties>
          </component>
          <component id="f9a7f" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-6180"/>
              <text value="Username"/>
            </properties>
          </component>
          <component id="ab932" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Arial" size="16" style="1"/>
              <foreground color="-6180"/>
              <text value="New Password"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
